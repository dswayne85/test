# Copy this file to ".env" and adjust for your machine.
# All values are optional; sensible defaults are applied in config.py.

# Absolute path to the Best Case executable. Used only when STARTING the app.
# Leave blank to connect to an already-running instance.
BESTCASE_EXECUTABLE_PATH=

# pywinauto backend: "uia" (recommended first) or "win32".
BESTCASE_BACKEND=uia

# Process image name used when connecting to a running instance.
BESTCASE_PROCESS_NAME=BestCase.exe

# Regex patterns used to locate windows by title. TUNE THESE AFTER INSPECTION.
BESTCASE_MAIN_WINDOW_TITLE_RE=.*Best Case.*
BESTCASE_CASE_WINDOW_TITLE_RE=.*Case.*
BESTCASE_CREDITOR_DIALOG_TITLE_RE=.*Creditor.*

# Timeouts (seconds) and retry behavior.
BESTCASE_CONNECT_TIMEOUT=30
BESTCASE_ACTION_TIMEOUT=15
BESTCASE_RETRY_ATTEMPTS=3
BESTCASE_RETRY_DELAY=1.0

# Output root. Subfolders logs/, screenshots/, reports/ are created under it.
BESTCASE_OUTPUT_DIR=output

# Logging level: DEBUG, INFO, WARNING, ERROR.
BESTCASE_LOG_LEVEL=INFO
